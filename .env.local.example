# Plantilla para docker-compose.local.yml. Copiar a ".env" en este mismo
# directorio (gr-infra/) antes de correr `docker compose -f docker-compose.local.yml up -d --build`.
# Nunca commitear el ".env" real.

DB_USERNAME=postgres
DB_PASSWORD=postgres

RABBITMQ_DEFAULT_USER=gr
RABBITMQ_DEFAULT_PASS=cambia-esto

# Debe ser el mismo secreto HMAC-SHA256 (>= 32 caracteres) en todos los servicios.
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Token compartido para llamadas servicio-a-servicio (nunca pasa por el gateway).
INTERNAL_SERVICE_TOKEN=cambia-esto-por-otro-secreto-aleatorio-de-al-menos-32-caracteres

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007

GATEWAY_PORT=4000
COOKIE_SECURE=false
