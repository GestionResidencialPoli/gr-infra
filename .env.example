# Este archivo se versiona como plantilla. El .env real con los valores
# verdaderos SOLO vive en el servidor (/home/mateodev/gr-infra/.env),
# nunca se commitea y nunca pasa por GitHub.

# --- Base de datos compartida (un solo Postgres, una base por servicio) ---
DB_USERNAME=
DB_PASSWORD=

# --- RabbitMQ (usuario propio, no dejar el guest/guest por defecto) ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Secreto HMAC compartido entre user-microservice, wall-microservice y gateway ---
# Debe ser identico en los tres, >= 32 caracteres aleatorios.
JWT_SECRET=

# --- Token compartido para llamadas servicio-a-servicio (nunca pasa por el gateway) ---
INTERNAL_SERVICE_TOKEN=

# --- CORS: dominio real del frontend en Vercel ---
CORS_ALLOWED_ORIGINS=https://residencialpoli.online

# --- Puerto local donde escucha el gateway (lo que cloudflared apunta) ---
GATEWAY_PORT=4000

# --- Tags de imagen (opcional). Si se dejan vacios, docker compose usa
# ":latest" de cada servicio, que es lo que Jenkins actualiza en cada deploy. ---
# USER_MS_TAG=
# WALL_MS_TAG=
# GATEWAY_TAG=
