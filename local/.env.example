# Plantilla para el Secret "gr-app-secrets" del entorno local de kind. Copiar a
# ".env" en este mismo directorio (local/). Nunca commitear el ".env" real.
# Formato --from-env-file: sin comillas, sin espacios alrededor del "=".

DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
INTERNAL_SERVICE_TOKEN=cambia-esto-por-otro-secreto-aleatorio-de-al-menos-32-caracteres
RABBITMQ_DEFAULT_USER=gr
RABBITMQ_DEFAULT_PASS=cambia-esto
CORS_ALLOWED_ORIGINS=http://common-ui.gr.local,http://admin-ui.gr.local,http://auth-ui.gr.local,http://wall-ui.gr.local,http://booking-ui.gr.local,http://gate-ui.gr.local,http://public-ui.gr.local,http://billing-ui.gr.local,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007
